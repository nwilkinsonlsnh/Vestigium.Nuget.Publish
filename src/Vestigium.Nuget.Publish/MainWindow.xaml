<Window x:Class="Vestigium.Nuget.Publish.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuget Publish"
        Height="820" Width="1560"
        MinHeight="640" MinWidth="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Vestigium.Controls;component/Shell/MenuChrome.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Radio.Bump" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" Margin="0,0,8,0">
                  <Ellipse Stroke="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
                           StrokeThickness="1.5"
                           Fill="{DynamicResource Vestigium.Brushes.Surface.Card}" />
                  <Ellipse x:Name="Dot" Width="8" Height="8"
                           Fill="{DynamicResource Vestigium.Brushes.Accent.Primary}"
                           Visibility="Collapsed" />
                </Grid>
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock DockPanel.Dock="Left"
                 Style="{StaticResource TextBlock.Caption}"
                 Text="Nuget Publish"
                 VerticalAlignment="Center" />
      <TextBlock HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                 Text="{Binding Status}" />
    </DockPanel>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>
      <Label Content="API key" Style="{StaticResource Label.Standard}" VerticalAlignment="Center" />
      <PasswordBox x:Name="KeyBox" Grid.Column="1" Margin="8,0,8,0" Height="28"
                   PasswordChanged="KeyBox_PasswordChanged"
                   Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   CaretBrush="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
      <TextBox Grid.Column="2" Style="{StaticResource TextBox.Standard}"
               Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="NuGet source"
               Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
               Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
               CaretBrush="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="12" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Repo roots" Margin="0,0,0,8"
                     Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add folder" Style="{StaticResource Button.Secondary}" Click="AddRoot_Click" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Remove" Style="{StaticResource Button.Secondary}" Command="{Binding RemoveRootCommand}" Padding="12,4" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Roots}"
                   SelectedItem="{Binding SelectedRoot}"
                   Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        </DockPanel>
        <DockPanel Grid.Row="2">
          <TextBlock DockPanel.Dock="Top" Text="Repositories" Margin="0,0,0,8"
                     Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Synchronize" Style="{StaticResource Button.Secondary}" Command="{Binding SynchronizeCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Copy" Style="{StaticResource Button.Secondary}" Command="{Binding CopyHeadCommand}" Padding="12,4" />
          </StackPanel>
          <ListBox x:Name="RepoList"
                   ItemsSource="{Binding Repos}"
                   SelectedItem="{Binding SelectedRepo, Mode=TwoWay}"
                   SelectionMode="Extended"
                   SelectionChanged="RepoList_SelectionChanged"
                   Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Head}" FontFamily="Consolas" FontSize="12"
                             Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Scan" Style="{StaticResource Button.Secondary}" Command="{Binding ScanCommand}" Padding="16,4" Margin="0,0,8,0" />
          <Button Content="Clean packs" Style="{StaticResource Button.Secondary}" Command="{Binding CleanPacksCommand}" Padding="16,4" Margin="0,0,8,0" />
          <Button Content="List packs" Style="{StaticResource Button.Secondary}" Command="{Binding ListPacksCommand}" Padding="16,4" Margin="0,0,12,0" />
          <RadioButton Content="Major" Style="{StaticResource Radio.Bump}" IsChecked="{Binding IsBumpMajor}" GroupName="Bump" />
          <RadioButton Content="Minor" Style="{StaticResource Radio.Bump}" IsChecked="{Binding IsBumpMinor}" GroupName="Bump" />
          <RadioButton Content="Patch" Style="{StaticResource Radio.Bump}" IsChecked="{Binding IsBumpPatch}" GroupName="Bump" />
          <Button Content="Pack" Style="{StaticResource Button.Primary}" Command="{Binding PackCommand}" Padding="16,4" Margin="0,0,8,0" />
          <Button Content="Push" Style="{StaticResource Button.Primary}" Command="{Binding PushCommand}" Padding="16,4" Margin="0,0,8,0" />
          <Button Content="Pack + Push" Style="{StaticResource Button.Primary}" Command="{Binding PackAndPushCommand}" Padding="16,4" Margin="0,0,8,0" />
          <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Padding="16,4" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="True">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Session log"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Copy log" Style="{StaticResource Button.Secondary}"
                      Command="{Binding CopyLogCommand}" Padding="12,4" Margin="0,0,8,0" />
              <Button Content="Clear log" Style="{StaticResource Button.Secondary}"
                      Command="{Binding ClearLogCommand}" Padding="12,4" />
            </StackPanel>
          </DockPanel>
          <TextBox Height="180"
                   Style="{StaticResource TextBox.Standard}"
                   Text="{Binding Log, Mode=OneWay}"
                   IsReadOnly="True"
                   FontFamily="Consolas"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap"
                   Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        </DockPanel>
        <DataGrid ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                  Style="{StaticResource DataGrid.Compact}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Repo" Binding="{Binding RepoName}" Width="180" />
            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="*" />
            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
            <DataGridTextColumn Header="Path" Binding="{Binding ProjectPath}" Width="2*" MinWidth="420" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>

<Window x:Class="Vestigium.Nuget.Publish.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vestigium.Nuget.Publish"
        Title="Nuget Publish"
        Icon="Assets/NugetPublish.ico"
        Height="820" Width="1560"
        MinHeight="640" MinWidth="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Vestigium.Brushes.Surface.Window}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Vestigium.Controls;component/Shell/MenuChrome.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <local:InverseBoolConverter x:Key="InverseBoolToVis" />
      <Style x:Key="PackText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Style.Triggers>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsPackable}" Value="False" />
              <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Status.Error}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </MultiDataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsPackable}" Value="False" />
              <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False" />
            </MultiDataTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PackMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="8,0,12,0"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                  <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Surface.Window}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PackMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Radio.Bump" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" Margin="0,0,8,0">
                  <Ellipse Stroke="{DynamicResource Vestigium.Brushes.Stroke.Subtle}"
                           StrokeThickness="1.5"
                           Fill="{DynamicResource Vestigium.Brushes.Surface.Card}" />
                  <Ellipse x:Name="Dot" Width="8" Height="8"
                           Fill="{DynamicResource Vestigium.Brushes.Accent.Primary}"
                           Visibility="Collapsed" />
                </Grid>
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock DockPanel.Dock="Left"
                 Style="{StaticResource TextBlock.Caption}"
                 Text="Nuget Publish"
                 VerticalAlignment="Center" />
      <TextBlock HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}"
                 Text="{Binding Status}" />
    </DockPanel>

    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>
      <Label Content="API key" Style="{StaticResource Label.Standard}" VerticalAlignment="Center" />
      <PasswordBox x:Name="KeyBox" Grid.Column="1" Margin="8,0,8,0" Height="28"
                   PasswordChanged="KeyBox_PasswordChanged"
                   Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   CaretBrush="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
      <TextBox Grid.Column="2" Style="{StaticResource TextBox.Standard}"
               Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="NuGet source"
               Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
               Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
               CaretBrush="{DynamicResource Vestigium.Brushes.Text.Primary}" />
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="12" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Repo roots" Margin="0,0,0,8"
                     Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add folder" Style="{StaticResource Button.Secondary}" Click="AddRoot_Click" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Remove" Style="{StaticResource Button.Secondary}" Command="{Binding RemoveRootCommand}" Padding="12,4" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Roots}"
                   SelectedItem="{Binding SelectedRoot}"
                   Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}" />
        </DockPanel>
        <DockPanel Grid.Row="2">
          <TextBlock DockPanel.Dock="Top" Text="Repositories" Margin="0,0,0,8"
                     Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Synchronize" Style="{StaticResource Button.Secondary}" Command="{Binding SynchronizeCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Copy" Style="{StaticResource Button.Secondary}" Command="{Binding CopyHeadCommand}" Padding="12,4" />
          </StackPanel>
          <ListBox x:Name="RepoList"
                   ItemsSource="{Binding Repos}"
                   SelectedItem="{Binding SelectedRepo, Mode=TwoWay}"
                   SelectionMode="Extended"
                   SelectionChanged="RepoList_SelectionChanged"
                   Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}"
                   BorderBrush="{DynamicResource Vestigium.Brushes.Stroke.Subtle}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Head}" FontFamily="Consolas" FontSize="12"
                             Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton Content="Packages" Style="{StaticResource RadioButton.HorizontalTab}" GroupName="PublishTabs" IsChecked="{Binding ShowPackages}" Margin="0,0,8,0" />
          <RadioButton Content="Log" Style="{StaticResource RadioButton.HorizontalTab}" GroupName="PublishTabs" IsChecked="{Binding ShowLog}" />
        </StackPanel>
        <DockPanel Visibility="{Binding ShowPackages, Converter={StaticResource BoolToVis}}">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Pack" Style="{StaticResource Button.Primary}" Command="{Binding PackCommand}" Padding="16,4" Margin="0,0,8,0" />
              <Button Content="Push" Style="{StaticResource Button.Primary}" Command="{Binding PushCommand}" Padding="16,4" Margin="0,0,8,0" />
              <Button Content="Pack + Push" Style="{StaticResource Button.Primary}" Command="{Binding PackAndPushCommand}" Padding="16,4" Margin="0,0,8,0" />
              <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Padding="16,4" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Content="Scan" Style="{StaticResource Button.Secondary}" Command="{Binding ScanCommand}" Padding="16,4" Margin="0,0,8,0" />
              <Button Content="Clean packs" Style="{StaticResource Button.Secondary}" Command="{Binding CleanPacksCommand}" Padding="16,4" Margin="0,0,8,0" />
              <Button Content="List packs" Style="{StaticResource Button.Secondary}" Command="{Binding ListPacksCommand}" Padding="16,4" Margin="0,0,8,0" />
              <Button Content="Clear cache" Style="{StaticResource Button.Secondary}" Command="{Binding ClearCacheCommand}" Padding="16,4" Margin="0,0,12,0" />
              <RadioButton Content="Major" Style="{StaticResource Radio.Bump}" IsChecked="{Binding IsBumpMajor}" GroupName="Bump" />
              <RadioButton Content="Minor" Style="{StaticResource Radio.Bump}" IsChecked="{Binding IsBumpMinor}" GroupName="Bump" />
              <RadioButton Content="Patch" Style="{StaticResource Radio.Bump}" IsChecked="{Binding IsBumpPatch}" GroupName="Bump" />
            </StackPanel>
          </DockPanel>
          <DataGrid ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                    Style="{StaticResource DataGrid.Compact}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    SelectionMode="Single"
                    HeadersVisibility="Column">
            <DataGrid.ContextMenu>
              <ContextMenu Style="{StaticResource PackMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Make packable" Style="{StaticResource PackMenuItem}" Command="{Binding MakePackableCommand}" Visibility="{Binding SelectedProject.IsPackable, Converter={StaticResource InverseBoolToVis}}">
                  <MenuItem.Icon><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Make unpackable" Style="{StaticResource PackMenuItem}" Command="{Binding MakeUnpackableCommand}" Visibility="{Binding SelectedProject.IsPackable, Converter={StaticResource BoolToVis}}">
                  <MenuItem.Icon><TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Make tool" Style="{StaticResource PackMenuItem}" Command="{Binding MakeToolCommand}" Visibility="{Binding SelectedProject.IsTool, Converter={StaticResource InverseBoolToVis}}">
                  <MenuItem.Icon><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Remove tool" Style="{StaticResource PackMenuItem}" Command="{Binding RemoveToolCommand}" Visibility="{Binding SelectedProject.IsTool, Converter={StaticResource BoolToVis}}">
                  <MenuItem.Icon><TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" /></MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsPackable}" Value="False" />
                      <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Status.Error}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsPackable}" Value="False" />
                      <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Accent.Primary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Repo" Binding="{Binding RepoName}" Width="160" ElementStyle="{StaticResource PackText}" />
              <DataGridTextColumn Header="Package" Binding="{Binding PackageId}" Width="*" ElementStyle="{StaticResource PackText}" />
              <DataGridTextColumn Header="IsPackable" Binding="{Binding IsPackableText}" Width="110" ElementStyle="{StaticResource PackText}" />
              <DataGridTextColumn Header="IsTool" Binding="{Binding IsToolText}" Width="90" ElementStyle="{StaticResource PackText}" />
              <DataGridTextColumn Header="NuGet" Binding="{Binding PublishedVersion}" Width="90" ElementStyle="{StaticResource PackText}" />
              <DataGridTextColumn Header="Local" Binding="{Binding LocalVersion}" Width="90" ElementStyle="{StaticResource PackText}" />
              <DataGridTextColumn Header="Path" Binding="{Binding ProjectPath}" Width="2*" MinWidth="280" ElementStyle="{StaticResource PackText}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        <DockPanel Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Session log" VerticalAlignment="Center" Foreground="{DynamicResource Vestigium.Brushes.Text.Secondary}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Copy log" Style="{StaticResource Button.Secondary}" Command="{Binding CopyLogCommand}" Padding="12,4" Margin="0,0,8,0" />
              <Button Content="Clear log" Style="{StaticResource Button.Secondary}" Command="{Binding ClearLogCommand}" Padding="12,4" />
            </StackPanel>
          </DockPanel>
          <TextBox x:Name="SessionLog"
                   Style="{StaticResource TextBox.Standard}"
                   Text="{Binding Log, Mode=OneWay}"
                   IsReadOnly="True"
                   FontFamily="Consolas"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap"
                   TextChanged="SessionLog_TextChanged"
                   Background="{DynamicResource Vestigium.Brushes.Surface.Card}"
                   Foreground="{DynamicResource Vestigium.Brushes.Text.Primary}" />
        </DockPanel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
